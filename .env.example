# Адрес сайта на своём домене (без слэша в конце).
# Используется в canonical-ссылках, превью для соцсетей, sitemap.xml и robots.txt.
VITE_SITE_URL=https://example.ru

# Отправка заявок с форм (EmailJS). Значения берутся в личном кабинете EmailJS.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
